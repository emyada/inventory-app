VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_INVENTORY_V2_ENABLED=false
VITE_INVENTORY_MUTATIONS_ENABLED=false
VITE_SUPABASE_EXPECTED_PROJECT_REF=
